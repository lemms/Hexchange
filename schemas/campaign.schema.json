          "type": "array"
        }
      },
      "required": [
        "code",
        "name"
      ],
      "title": "CodeDef",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "Test on one world attribute: ``min <= value <= max`` and/or ``value in values``.",
      "properties": {
        "attr": {
          "title": "Attr",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        }
      },
      "required": [
        "attr"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Demand": {
