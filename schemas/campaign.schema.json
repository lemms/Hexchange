{
  "$defs": {
    "AttrMod": {
      "additionalProperties": false,
      "description": "Modifier added to an attribute roll, from another attribute.\n\nNumeric: ``factor * (other + offset)``.  Table: ``table[str(other)]`` (key\n``\"*\"`` is the default).",
      "properties": {
        "attr": {
          "title": "Attr",
          "type": "string"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "title": "Offset",
          "type": "number"
        },
        "table": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        }
      },
      "required": [
        "attr"
      ],
      "title": "AttrMod",
      "type": "object"
    },
    "AttrRule": {
      "additionalProperties": false,
      "description": "Override applied after rolling: when all conditions hold, set (or add).",
      "properties": {
        "when": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "When",
          "type": "array"
        },
        "set": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Set"
        },
        "add": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Add"
        }
      },
      "required": [
        "when"
      ],
      "title": "AttrRule",
      "type": "object"
    },
    "AttributeDef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "default": "int",
          "enum": [
            "int",
            "category"
          ],
          "title": "Kind",
          "type": "string"
        },
        "min": {
          "default": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "default": 15,
          "title": "Max",
          "type": "integer"
        },
        "values": {
          "description": "category values, in order",
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        },
        "roll": {
          "default": "2d6",
          "description": "dice expression, e.g. '2d6', '1d6', '0'",
          "title": "Roll",
          "type": "string"
        },
        "add": {
          "default": 0,
          "title": "Add",
          "type": "number"
        },
        "mods": {
          "items": {
            "$ref": "#/$defs/AttrMod"
          },
          "title": "Mods",
          "type": "array"
        },
        "roll_table": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "category attributes: roll result -> value ('*' default, ranges like '3-4')",
          "title": "Roll Table"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/AttrRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "encoding": {
          "default": "int",
          "enum": [
            "int",
            "ehex",
            "raw"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "descriptions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Descriptions",
          "type": "object"
        }
      },
      "required": [
        "key",
        "name"
      ],
      "title": "AttributeDef",
      "type": "object"
    },
    "CodeDef": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
